<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Rueckweg aus der Google-Anmeldung.

                 Nach der Anmeldung schickt Supabase an
                 com.myprosole.app://login-callback. Android weiss durch
                 diesen Eintrag, dass diese Adresse zu dieser App gehoert,
                 und weckt sie statt einen Browser zu oeffnen.

                 Eigenes Adressschema statt https: Ein https-Verweis
                 verlangt, dass die Domain den Fingerabdruck der
                 App-Signierung bestaetigt (assetlinks.json). Dafuer
                 braeuchte es einen Release-Schluessel, den es hier noch
                 nicht gibt. Vor der Veroeffentlichung wird umgestellt;
                 beide Wege koennen dann nebeneinander bestehen. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.myprosole.app" android:host="login-callback" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Der Dienst, der die Aufzeichnung am Leben haelt, wenn der
             Bildschirm ausgeht oder jemand zur Musik-App wechselt.

             exported="false": Niemand ausser dieser App darf ihn starten.
             Die Fremdwerke, die wir als Vorlage gelesen haben, stehen hier
             auf true - ohne Grund, denn angesprochen wird der Dienst nur aus
             dem eigenen Prozess.

             foregroundServiceType: Ab Android 14 Pflicht. Ohne die Angabe
             verweigert das System den Start. -->
        <service
            android:name=".aufzeichnung.AufzeichnungsDienst"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Bluetooth fuer Brustgurte, Uhren im Sendemodus und spaeter die
         Einlage.

         Seit Android 12 sind Suchen und Verbinden getrennte Rechte.
         usesPermissionFlags="neverForLocation" sagt dem System ausdruecklich,
         dass wir aus Bluetooth-Funden keinen Standort ableiten – nur damit
         entfaellt die Standortberechtigung, die man sonst zusaetzlich
         braeuchte und die hier nichts zu suchen haette.

         Die beiden alten Rechte gelten nur bis Android 11; ab 12 ersetzen
         die neuen sie. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!-- Standort fuer die Laufaufzeichnung.

         Bis heute stand hier NICHTS davon: Die Rechte kamen zufaellig ueber
         das Manifest des Bluetooth-Plugins herein, das beim Bauen mit diesem
         verschmolzen wird. GPS funktionierte also nur, weil ein Plugin fuer
         einen ganz anderen Zweck die Erlaubnis mitbrachte. Faellt das Plugin
         weg oder aendert es seine Angaben, waere die Ortung still weg. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ACCESS_BACKGROUND_LOCATION steht hier bewusst NICHT.

         Google verlangt dafuer ein eigenes, aufwendiges Verfahren mit Video
         und inhaltlicher Pruefung. Wir brauchen es nicht: Die Ausnahme fuer
         nutzergestartete Vordergrunddienste beschreibt unseren Ablauf
         woertlich - der Nutzer tippt "Lauf starten", der Dienst laeuft, beim
         Beenden endet er.

         Daran haengt eine Bauregel: Der Dienst MUSS beim Beenden des Laufs
         wirklich enden. Laeuft er weiter, gilt der Zugriff laut Google als
         gleichwertig mit ACCESS_BACKGROUND_LOCATION - und dann greifen die
         vollen Anforderungen doch. -->

    <!-- Vordergrunddienst. Die zweite Zeile ist seit Android 14 zusaetzlich
         noetig, um einen Dienst vom Typ "location" ueberhaupt starten zu
         duerfen. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Ab Android 13 muss die Benachrichtigung eigens erlaubt werden. Ohne
         sie laeuft der Dienst zwar, ist aber unsichtbar - und eine
         Standortaufzeichnung, die man nicht sieht, will niemand. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Waehrend der Aufzeichnung darf der Rechenkern nicht schlafen gehen.
         Ohne das verwirft Android im Doze-Zustand Messungen, bevor sie
         gespeichert sind. Die Sperre haelt nur, solange ein Lauf laeuft. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Ohne GPS-Empfaenger ergibt die App keinen Sinn. required="false",
         damit sie im Play Store trotzdem fuer Geraete ohne GPS sichtbar
         bleibt - dort funktioniert dann alles ausser der Aufzeichnung. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

</manifest>
