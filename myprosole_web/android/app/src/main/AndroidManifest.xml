<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Rueckweg aus der Google-Anmeldung.

                 Nach der Anmeldung schickt Supabase an
                 com.myprosole.app://login-callback. Android weiss durch
                 diesen Eintrag, dass diese Adresse zu dieser App gehoert,
                 und weckt sie statt einen Browser zu oeffnen.

                 Eigenes Adressschema statt https: Ein https-Verweis
                 verlangt, dass die Domain den Fingerabdruck der
                 App-Signierung bestaetigt (assetlinks.json). Dafuer
                 braeuchte es einen Release-Schluessel, den es hier noch
                 nicht gibt. Vor der Veroeffentlichung wird umgestellt;
                 beide Wege koennen dann nebeneinander bestehen. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.myprosole.app" android:host="login-callback" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Fuer die GPS-Aufzeichnung waehrend eines Laufs (navigator.geolocation
         in LiveTracking.tsx). Ohne diese Deklaration lehnt Android jede
         Laufzeit-Anfrage der WebView nach dem Standort automatisch ab, ohne
         dass der Nutzer je einen Berechtigungsdialog sieht. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
</manifest>
