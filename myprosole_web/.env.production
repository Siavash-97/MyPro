# Werte fuer den Produktionsbau (npm run build). Gehoert ins Repo.
#
# Warum das hier stehen darf
# --------------------------
# Alle drei Werte sind ohnehin oeffentlich: Sie stecken in jedem
# ausgelieferten Bundle und sind von dort ablesbar. Ihr Schutz liegt nicht
# im Verstecken.
#
#   VITE_SUPABASE_ANON_KEY  – enthaelt role: anon. Was damit lesbar und
#                             schreibbar ist, entscheiden allein die
#                             Zeilenrechte in der Datenbank.
#   VITE_MAPTILER_KEY       – abgesichert ueber die erlaubte Herkunft im
#                             MapTiler-Konto, nicht ueber Geheimhaltung.
#
# Warum eingecheckt und nicht nur lokal
# -------------------------------------
# Eine Datei, die nur auf einem Rechner liegt, ist eine unsichtbare
# Voraussetzung: Auf jedem anderen Rechner baut das Projekt dann mit den
# Attrappen-Werten aus .env.local – und die App zeigt auf
# mock.supabase.co, ohne dass es auffaellt. Genau das ist passiert.
#
# Was hier NIE hineingehoert
# --------------------------
# Der service_role-Schluessel. Der umgeht alle Zeilenrechte. Er ist
# nirgends im Projekt und darf es auch nie sein.
#
# .env.local behaelt die Attrappe mock.supabase.co, damit die
# automatischen Tests nicht gegen die echte Datenbank laufen. Beim Bauen
# gewinnt diese Datei.
VITE_SUPABASE_URL=https://pssyomphfjvhnnuljtzh.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBzc3lvbXBoZmp2aG5udWxqdHpoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY2MDc0NzUsImV4cCI6MjEwMjE4MzQ3NX0.ecbCXVCV5KmNguphOcAY2IADrTO3D6u3UgAFg1ziSx0
VITE_MAPTILER_KEY=B8axmO48IeLTR7sp5GO1

# Wohin der Bestaetigungslink aus der Registriermail fuehrt, wenn die App in
# der Android-Huelle laeuft. Dort ist die eigene Herkunft https://localhost –
# eine Adresse, die es im Browser des Telefons nicht gibt. Kein Geheimnis: Die
# Adresse steht ohnehin in jeder E-Mail. Muss in der Redirect-Liste des
# Supabase-Projekts stehen.
VITE_PUBLIC_SITE_URL=https://my-pro-n38r.vercel.app
