VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Kartenkacheln von MapTiler (https://cloud.maptiler.com -> Account -> API keys).
# Optional: Fehlt der Schluessel, zeigt die App statt der Karte die gezeichnete
# Flaeche aus dem Entwurf. Die Route selbst wird in beiden Faellen angezeigt.
VITE_MAPTILER_KEY=

# Oeffentliche Adresse der ausgelieferten Web-App, ohne abschliessenden
# Schraegstrich. Wird nur in der Android-Huelle gebraucht: Dort laeuft die App
# unter https://localhost, und ein Bestaetigungslink dorthin fuehrt ins Leere.
# Im Browser gilt stattdessen die eigene Herkunft. Die Adresse muss in der
# Redirect-Liste des Supabase-Projekts stehen.
VITE_PUBLIC_SITE_URL=https://my-pro-n38r.vercel.app
