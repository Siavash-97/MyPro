# Kopiere diese Datei zu .streamlit/secrets.toml (lokal, wird nicht committed)
# und/oder trage dieselben zwei Werte im Streamlit Community Cloud Dashboard
# unter "Settings -> Secrets" ein, um den Login-Schutz zu aktivieren.
# Ohne diese Werte läuft die App ohne Login (z.B. für lokale Entwicklung).

app_username = "info"
app_password = "dein-passwort-hier"
